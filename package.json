{
  "name": "tommievoice",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env server/src/main.ts",
    "dev:worker": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env server/src/worker/main.ts",
    "start:api": "node --disable-warning=ExperimentalWarning server/src/main.ts",
    "start:worker": "node --disable-warning=ExperimentalWarning server/src/worker/main.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:md": "markdownlint '*.md'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/db/migrate.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "1.63",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "markdownlint-cli": "^0.49.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "1.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
