# tommieVoice 本番用の環境変数テンプレート。
# VPS 上で `cp deploy/env.example .env` してから値を埋める（.env は git 管理外）。
# 鍵は `openssl rand -hex 32` などで生成する。32 文字未満は起動時に拒否される。

# ---- PostgreSQL（db コンテナ） ----
POSTGRES_USER=tommievoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tommievoice

# ---- api / worker ----
NODE_ENV=production
DATABASE_URL=postgres://tommievoice:change-me@db:5432/tommievoice
PUBLIC_ORIGIN=https://voice.tommie.jp
# api の直前は web nginx の 1 段（web nginx が実クライアント IP で X-Forwarded-For を上書きする）
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# 管理画面のトークン
ADMIN_TOKEN=change-me-to-a-random-string-of-32-chars-or-more
# IP・端末 ID のハッシュ用 HMAC 鍵（変更すると過去のレート制限・通報の突合ができなくなる）
HASH_KEY=change-me-to-a-random-string-of-32-chars-or-more
# 配信者セッション cookie の署名鍵
SESSION_KEY=change-me-to-a-random-string-of-32-chars-or-more
# 自宅 GPU ワーカー（設計メモ 04）を使う場合のみ
# WORKER_TOKEN=change-me-to-a-random-string-of-32-chars-or-more

# 本番では次の 2 つは指定しないこと（指定すると起動時に拒否される）
#   RELAX_RATE_LIMITS  投稿レート制限の緩和（ローカル検証用）
#   SYNC_MEDIA         変換を省いて原本をそのまま公開（E2E 用）

# NG ワード一覧（1 行 1 語）。任意
# NG_WORDS_FILE=/app/data/ng-words.txt
